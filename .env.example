# ==============================================================================
# Anime Gallery Manager - Environment Variables Configuration
# ==============================================================================

# Server Port & Host
SERVER_HOST=0.0.0.0
SERVER_PORT=8088

# Storage Directory
ANIME_DATA_DIR=/data/anime-gallery

# Security & Admin Session Token (Optional)
API_SECRET_KEY=change_this_to_a_random_secure_token

# Pixiv Official OAuth Credentials (User Provided)
PIXIV_REFRESH_TOKEN=

# Google Photos Integration (Reserved for Future Sync)
GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=
GOOGLE_PHOTOS_REFRESH_TOKEN=
GOOGLE_PHOTOS_ALBUM_NAME=Anime Gallery Favorites

# Quota & Limits
DEFAULT_SEARCH_LIMIT=100
MAX_SEARCH_LIMIT=300
MAX_DISK_USAGE_PERCENT=85
